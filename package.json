{
  "name": "folk-radio-nazdrave",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build && node scripts/inline-built-css.mjs",
    "preview": "node server.mjs --production",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs --report reviews/i18n-results.json",
    "qa:manual": "node scripts/run-manual-qa.mjs",
    "qa:a11y": "node scripts/run-accessibility-qa.mjs",
    "qa:future": "node scripts/run-future-qa.mjs",
    "review:all": "node scripts/run-agent-reviews.mjs",
    "ci:review": "node scripts/run-agent-reviews.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.58.2",
    "vite": "^7.3.2"
  },
  "overrides": {
    "path-to-regexp": "^8.4.2",
    "picomatch": "^4.0.4"
  }
}
